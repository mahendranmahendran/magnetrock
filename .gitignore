# Whitelist approach — everything is blocked unless explicitly allowed.

# 1. Block everything
*

# 2. Allow git to traverse directories
!*/

# 3. Re-block directories that must never be committed
node_modules/
.next/
out/
build/
dist/
coverage/
.yarn/
.pnp/

# 4. Block generated, secret, and OS noise at any depth
*.log
*.tsbuildinfo
next-env.d.ts
.env
.env.*
*.pem
*.key
.DS_Store
Thumbs.db
.vercel/

# ── Whitelisted root files ────────────────────────────────────────────────
!.gitignore
!AGENTS.md
!CLAUDE.md
!README.md
!next.config.ts
!package.json
!package-lock.json
!tsconfig.json
!postcss.config.mjs
!eslint.config.mjs

# ── Whitelisted source directories ───────────────────────────────────────
!app/**
!public/**
